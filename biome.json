{
    "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
    "files": {
        "includes": ["**/*.{tsx,ts,json,css}", "!**/node_modules/*", "!**/dist/*", "!**/build/*", "!**/public/*"]
    },
    "formatter": {
        "lineWidth": 120,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "rules": {
            "a11y": {
                "noStaticElementInteractions": "off"
            },
            "suspicious": {
                "noTemplateCurlyInString": "off"
            }
        }
    }
}
